run = "npm run dev"
entrypoint = "index.html"
modules = ["nodejs-20"]

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 4173
externalPort = 3000

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "npm install && npm run build"]
publicDir = "dist"

[agent]
expertMode = true
